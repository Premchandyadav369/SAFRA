# SAFRA Backend Environment Configuration
DATABASE_URL=sqlite+aiosqlite:///./safra.db
# For PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/safra

# Groq AI Key (Optional - Fallback deterministic engine runs if omitted)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Redis URL (Optional)
REDIS_URL=redis://localhost:6379/0
USE_IN_MEMORY_BUS=true
